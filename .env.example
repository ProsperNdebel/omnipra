# Copy to .env.local and fill in.

# Supabase: URL from the Connect button; keys from Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser or commit.
SUPABASE_SECRET_KEY=

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace (Console > Settings > Workspaces).
ANTHROPIC_WORKSPACE_ID=

# Set to 1 to run with canned transcripts and notes: no Deepgram or Claude calls, no credits.
PRESENCE_FAKE_AI=
