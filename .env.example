# Copy to .env.local and fill in.

# Supabase: URL from the Connect button; keys from Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser or commit.
SUPABASE_SECRET_KEY=

# 1 turns on sign in (email codes through Supabase Auth). Required before anyone else
# uses it. Without it every browser gets an anonymous identity.
OMNIPRA_AUTH=

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace (Console > Settings > Workspaces).
ANTHROPIC_WORKSPACE_ID=

# Set to 1 to run with canned transcripts and notes: no Deepgram or Claude calls, no credits.
PRESENCE_FAKE_AI=
# 1 enables /api/dev/ai-check, which runs every AI call once against the real providers (spends tokens).
OMNIPRA_DEV_CHECKS=
# Any long random string. The scheduler sends it to /api/cron/* (Vercel does this for you).
CRON_SECRET=
